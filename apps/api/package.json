{
  "name": "@floodaid/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm run start:dev",
    "start:dev": "node --env-file-if-exists=.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/health.spec.js dist-test/test/flood-reports.spec.js dist-test/test/auth.spec.js",
    "test:integration": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env --test dist-test/test/database.spec.js dist-test/test/flood-reports.integration.js dist-test/test/auth.integration.js",
    "staff:create": "pnpm run build && node --env-file-if-exists=.env dist/cli/create-staff.js",
    "staff:reset-password": "pnpm run build && node --env-file-if-exists=.env dist/cli/create-staff.js --reset-password",
    "typeorm": "node --env-file-if-exists=.env ./node_modules/typeorm/cli.js",
    "migration:run": "pnpm run build && pnpm run typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "pnpm run build && pnpm run typeorm migration:revert -d dist/database/data-source.js",
    "migration:generate": "pnpm run build && pnpm run typeorm migration:generate -d dist/database/data-source.js"
  },
  "dependencies": {
    "@floodaid/contracts": "workspace:*",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/typeorm": "11.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
