{
  "name": "floodaid",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @floodaid/api --filter @floodaid/web --parallel run dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @floodaid/api test:integration",
    "db:migrate": "pnpm --filter @floodaid/api migration:run"
  }
}
